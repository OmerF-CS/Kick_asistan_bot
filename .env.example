# ============================================
#   KICK ASISTAN - YAPILANDIRMA DOSYASI
# ============================================

# --- Google Gemini API ---
# Google AI Studio'dan al: https://aistudio.google.com/apikey
GEMINI_API_KEY=senin_gemini_api_anahtarin_buraya

# --- Kick Kanal Ayarlarý ---
# Kick kanal slug'ýn (URL'deki isim, ör: kick.com/kanal_adin)
KICK_CHANNEL_SLUG=senin_kanal_adin

# Botun sohbette görünecek adý
BOT_NAME=AsistanBot

# --- Kick OAuth Ayarlarý (Mesaj Göndermek Ýçin) ---
KICK_CLIENT_ID=senin_kick_client_id_buraya
KICK_CLIENT_SECRET=senin_kick_client_secret_buraya
KICK_REDIRECT_URI=http://localhost:3000/callback

# Sessizlik kirici ayarlari (True/False)
ENABLE_SILENCE_BREAKER=True

